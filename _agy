#compdef agy

# Generated from the help output of Antigravity CLI 1.5.3.

_agy_node() {
  subs=() alias_pairs=() opts=() args=()
  case $1 in
    '')
      subs=(
        'acp:Start the Agent Client Protocol (ACP) stdio server'
        'agent:List available agents'
        'agents:List available agents'
        'changelog:Show changelog and release notes'
        'help:Show help for subcommands'
        'install:Configure environment paths and shell settings'
        'mcp:Manage MCP servers (add, remove, list, enable, disable)'
        'mic-serve:Serve this machine'\''s microphone to a CLI on another host'
        'models:List available models'
        'plugin:Manage plugins (install, uninstall, list, enable, disable)'
        'plugins:Manage plugins (install, uninstall, list, enable, disable)'
        'remote-control:Manage the remote-control background daemon (start, status, stop)'
        'update:Update CLI'
      )
      alias_pairs=(agents agent plugins plugin)
      opts=(
        '*--add-dir=[Add a directory to the workspace (repeatable)]:add-dir:_files -/'
        '--agent=[Agent for the current CLI session]:agent: '
        '(-c --continue)'{-c,--continue}'[Continue the most recent conversation]'
        '--conversation=[Resume a previous conversation by ID]:conversation: '
        '--dangerously-skip-permissions[Auto-approve all tool permission requests without prompting]'
        '--disable-slash-commands[Disable slash command and skill expansion in print mode]'
        '--effort=[Reasoning effort for the current CLI session (low|medium|high|xhigh|max)]:effort:(low medium high xhigh max)'
        '--input-format=[Input format for print mode (text, stream-json).]:input-format:(text stream-json)'
        '--json-schema=[Optional JSON schema string or path to a schema file to enforce structured output (for stream-json, only applicable to...]:json-schema:_files'
        '--log-file=[Override CLI log file path]:log-file:_files'
        '--mode=[Set the agent execution mode for this session (accept-edits, auto, plan)]:mode:(accept-edits auto plan)'
        '--model=[Model for the current CLI session]:model: '
        '--new-project[Create a new project for this session]'
        '--output-format=[Output format for print mode (text, json, stream-json) (default text)]:output-format:(text json stream-json)'
        '(-p --print)'{-p=,--print=}'[Run a single prompt non-interactively and print the response]:print: '
        '--print-timeout=[Optional time limit for print mode; 0 waits until the turn completes (default 0s)]:print-timeout: '
        '--project=[Project ID or project name for the current CLI session]:project: '
        '--prompt=[Alias for --print]:prompt: '
        '(-i --prompt-interactive)'{-i=,--prompt-interactive=}'[Run an initial prompt interactively and continue the session]:prompt-interactive: '
        '--remote-agent[Run this session'\''s conversations using remote agents; --project then names a remote project by ID or name, otherwise...]'
        '--remote-control[Create a remote connection for the CLI session on start up]'
        '--sandbox[Run in a sandbox with terminal restrictions enabled]'
        '--settings=[Settings for this session only, never saved: a JSON object of settings.json keys, inline or as a file path]:settings:_files'
        '(-h --help)'{-h,--help}'[Show help]'
        '--version[Show the CLI version]'
      )
      args=(': :->command')
      ;;
    'acp')
      opts=(
        '*--add-dir=[Add a directory to the workspace (repeatable)]:add-dir:_files -/'
        '--agent[Agent for the ACP session]'
        '--app-data-dir=[Path where application data is stored (default antigravity-cli)]:app-data-dir: '
        '--app_data_dir=[Path where application data is stored (default antigravity-cli)]:app_data_dir: '
        '--cli_dir_name[Subdirectory under app_data_dir for CLI settings and logs]'
        '--cli_log_file=[Override ACP log file path]:cli_log_file:_files'
        '--cloud_code_endpoint=[CCPA API URL (default https://daily-cloudcode-pa.googleapis.com)]:cloud_code_endpoint: '
        '--dangerously-skip-permissions[Auto-approve all tool permission requests]'
        '--disable-telemetry[If true, disable telemetry]'
        '--disable_telemetry[If true, disable telemetry]'
        '--gemini-dir=[Path where Gemini files are stored (default .gemini)]:gemini-dir: '
        '--gemini_dir=[Path where Gemini files are stored (default .gemini)]:gemini_dir: '
        '(-h --help)'{-h,--help}'[Show help]'
        '--ide-mcp-port=[Port for host IDE tools MCP server (requires '\''nc'\'' in $PATH) (default 0)]:ide-mcp-port: '
        '--ide_mcp_port=[Port for host IDE tools MCP server (requires '\''nc'\'' in $PATH) (default 0)]:ide_mcp_port: '
        '--include-default-customizations[Include default customizations (default true)]'
        '--is_google3_workspace[Whether running in Google environment]'
        '--is_google_internal[Deprecated: use is_google3_workspace]'
        '--log-file=[Override ACP log file path]:log-file:_files'
        '--login[Log in with Google interactively, then exit (ACP terminal auth)]'
        '--override_user_agent_name[Override user agent name for HTTP requests]'
        '--process-per-session[Serve each session from an isolated worker process]'
        '--sandbox[Run in a sandbox with terminal restrictions enabled]'
        '--stdio[Use stdio JSON-RPC transport (default)]'
        '--use_stubby_auth[Use LOAS auth]'
        '--worker[Serve a single session for an ACP front process (internal)]'
      )
      ;;
    'agent')
      opts=(
        '(-h --help)'{-h,--help}'[Show help]'
      )
      ;;
    'changelog')
      opts=(
        '(-h --help)'{-h,--help}'[Show help]'
      )
      ;;
    'install')
      opts=(
        '--dir=[Custom directory target to configure PATH for]:dir:_files -/'
        '(-h --help)'{-h,--help}'[Show help]'
        '--skip-aliases[Bypasses shell profile alias purging]'
        '--skip-path[Bypasses shell profile PATH appending]'
      )
      ;;
    'mcp')
      subs=(
        'add:Add or update an MCP server configuration'
        'remove:Remove an MCP server configuration'
        'list:List all configured MCP servers'
        'enable:Enable an MCP server'
        'disable:Disable an MCP server'
      )
      args=(': :->command')
      ;;
    'mcp add')
      opts=(
        '*'{-e=,--env=}'[Environment variable KEY=value (repeatable)]:env: '
        '*'{-H=,--header=}'[HTTP header Key: Value (repeatable)]:header: '
        '(-h --help)'{-h,--help}'[Show help]'
        '(-t --type)'{-t=,--type=}'[Server type: '\''stdio'\'' or '\''http'\'' (default stdio)]:type:(stdio http)'
      )
      args=(':name: ' ':commandOrUrl: ' '*:args: ')
      ;;
    'mcp remove')
      opts=(
        '(-h --help)'{-h,--help}'[Show help]'
      )
      args=(':name: ')
      ;;
    'mcp list')
      opts=(
        '(-h --help)'{-h,--help}'[Show help]'
      )
      ;;
    'mcp enable')
      opts=(
        '(-h --help)'{-h,--help}'[Show help]'
      )
      args=(':name: ')
      ;;
    'mcp disable')
      opts=(
        '(-h --help)'{-h,--help}'[Show help]'
      )
      args=(':name: ')
      ;;
    'mic-serve')
      opts=(
        '--addr=[Address to listen on; keep it on loopback (default 127.0.0.1:4713)]:addr: '
        '(-h --help)'{-h,--help}'[Show help]'
      )
      ;;
    'models')
      opts=(
        '(-h --help)'{-h,--help}'[Show help]'
      )
      ;;
    'plugin')
      subs=(
        'list:List installed plugins'
        'import:Import plugins from gemini or claude'
        'install:Install a plugin (supports plugin[@marketplace])'
        'uninstall:Uninstall a plugin'
        'enable:Enable a plugin'
        'disable:Disable a plugin'
        'validate:'
        'link:Generate link to a marketplace'
        'help:Show this help'
      )
      args=(': :->command')
      ;;
    'plugin list')
      args=('::--json: ')
      ;;
    'plugin import')
      args=('::source: ')
      ;;
    'plugin install')
      args=(':target: ')
      ;;
    'plugin uninstall')
      args=(':name: ')
      ;;
    'plugin enable')
      args=(':name: ')
      ;;
    'plugin disable')
      args=(':name: ')
      ;;
    'plugin validate')
      args=('::path:_files' '::--strict: ' '::--json: ')
      ;;
    'plugin link')
      args=(':mp: ' ':target: ')
      ;;
    'remote-control')
      subs=(
        'start:Register and start the remote-control daemon'
        'status:Show the daemon'\''s status'
        'stop:Stop the daemon and unregister it'
      )
      args=(': :->command')
      ;;
    'remote-control start')
      opts=(
        '(-h --help)'{-h,--help}'[Show help]'
        '--name=[Set this machine'\''s instance name shown in Remote Control]:name: '
        '--session[Register the daemon login-scoped (stops at logout) instead of starting at boot]'
      )
      ;;
    'remote-control status')
      opts=(
        '(-h --help)'{-h,--help}'[Show help]'
      )
      ;;
    'remote-control stop')
      opts=(
        '(-h --help)'{-h,--help}'[Show help]'
      )
      ;;
  esac
}

_agy_load() {
  local spec flag
  _agy_node "$node"
  alias_of=($alias_pairs)
  value_flags=()
  for spec in $opts; do
    spec=${spec#\(*\)}
    flag=${${spec#\*}%%[\[:]*}
    [[ $flag == *= ]] && value_flags+=(${flag%=})
  done
}

_agy() {
  local curcontext=$curcontext state state_descr line node word
  local -a subs alias_pairs opts args value_flags
  local -A opt_args alias_of
  local -i i=2 start=1 positional=0 ret=1

  _agy_load
  while (( i < CURRENT )); do
    word=$words[i]
    if [[ $word == -- ]]; then
      break
    elif [[ $word == -?* ]]; then
      [[ $word != *=* ]] && (( $value_flags[(Ie)$word] )) && (( i++ ))
    elif (( ! positional )); then
      word=${alias_of[$word]:-$word}
      if [[ -z $node && $word == help ]]; then
        start=$i
      elif (( $subs[(I)${(b)word}:*] )); then
        node="${node:+$node }$word"
        start=$i
        _agy_load
      else
        positional=1
      fi
    fi
    (( i++ ))
  done

  words=($words[1] "${(@)words[start+1,-1]}")
  (( CURRENT -= start - 1 ))

  _arguments -S -C : $opts $args && ret=0
  if [[ $state == command ]]; then
    _describe -t commands 'agy command' subs && ret=0
  fi
  return ret
}

_agy "$@"
